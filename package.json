{
  "name": "desktop-pet",
  "version": "1.0.1",
  "description": "一只住在桌面上的咕嘎",
  "productName": "DesktopPet",
  "main": "main.js",
  "private": true,
  "author": {
    "name": "baozi",
    "email": "2692908265@qq.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "icon": "python tools/make-tray-icon.py",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.baozi.desktoppet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "system-monitor.js",
      "net-service.js",
      "weather.js",
      "desktop-icons.js",
      "src/**/*",
      "assets/pet-penguin-*.png",
      "assets/tray.png",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "DesktopPet-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "咕嘎"
    },
    "portable": {
      "artifactName": "DesktopPet-Portable-${version}.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment",
      "artifactName": "DesktopPet-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "一只住在桌面上的咕嘎",
      "artifactName": "DesktopPet-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
